---
interface Project {
  title: string;
  slug: string;
  image: string;
  link?: string;
  preview?: string;
  status?: string;
}

const projects: Project[] = [
  {
    title: "Developer portals, user manuals, and technical content",
    slug: "technical-writing",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Technical+writing",
  },
  {
    title: "Enablement, training, and instructional content",
    slug: "instructional-design",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Instructional+design",
  },
  {
    title: "Tools, scripts, and integrations",
    slug: "tools-and-scripts",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Content+tools",
  },
  {
    title: "Various creative projects",
    slug: "personal-projects",
    image: "https://placehold.co/600x400/1a1a1a/ffffff?text=Personal+projects",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group">
            <a
              href={`/projects/${project.slug}`}
              class="block"
            >
              <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="flex items-center px-3">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold">{project.title}</h4>
                  {project.status && (
                    <span class="py-1 text-sm text-[var(--white-icon)]">
                      {project.status}
                    </span>
                  )}
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>