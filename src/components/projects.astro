---
interface Project {
  title: string;
  slug: string;
  link?: string;
  preview?: string;
  status?: string;
}

const projects: Project[] = [
    {
    title: "Content tools",
    slug: "tools-and-scripts",
    status: "Tools, scripts, and integrations",
  },
  {
    title: "Technical writing",
    slug: "technical-writing",
    status: "Developer portals, user manuals, and technical content",
  },
  {
    title: "Instructional design",
    slug: "instructional-design",
    status: "Enablement, training, and instructional content",
  },
  {
    title: "Personal projects",
    slug: "personal-projects",
    status: "Various creative projects",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto px-4 md:px-0">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <div class="group">
            <a
              href={`/projects/${project.slug}`}
              class="block p-6 rounded-2xl bg-[#141414] border-2 border-[#0e7490] hover:border-[var(--sec)] transition-all duration-300 shadow-lg hover:shadow-xl h-44 md:h-48 flex flex-col justify-between transform hover:-translate-y-1"
            >
              <div>
                <h4 class="text-2xl font-semibold mb-2 group-hover:text-[var(--sec)] transition-colors duration-300">
                  {project.title}
                </h4>
              </div>
              <div>
                {project.status && (
                  <p class="text-sm text-[var(--white-icon)] line-clamp-2">
                    {project.status}
                  </p>
                )}
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>