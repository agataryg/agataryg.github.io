---
interface CaseStudy {
  title: string;
  slug: string;
  link?: string;
  preview?: string;
  shortdesc?: string;
}

const caseStudies: caseStudy[] = [
    {
    title: "From zero to a portfolio in 10 hours",
    slug: "portfolio-case-study",
    shortdesc: "Learn how I created this website",
  },

];
---

<section
  id="case-studies"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto px-4 md:px-0">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Deep dives</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Case studies</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        caseStudies.map((caseStudy) => (
          <div class="group">
            <a
              href={`/case-studies/${caseStudy.slug}`}
              class="block p-6 rounded-2xl bg-[#141414] border-2 border-[#0e7490] hover:border-[var(--sec)] transition-all duration-300 shadow-lg hover:shadow-xl h-44 md:h-48 flex flex-col justify-between transform hover:-translate-y-1"
            >
              <div>
                <h4 class="text-2xl font-semibold mb-2 group-hover:text-[var(--sec)] transition-colors duration-300">
                  {caseStudy.title}
                </h4>
              </div>
              <div>
                {caseStudy.shortdesc && (
                  <p class="text-base text-[var(--white-icon)] line-clamp-2">
                    {caseStudy.shortdesc}
                  </p>
                )}
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>