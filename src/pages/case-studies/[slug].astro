---
import Layout from '../../layouts/Layout.astro';
import BackToTop from '../../components/BackToTop.astro';
export async function getStaticPaths() {
  const caseStudyModules = import.meta.glob(
    '../../../content/case-studies/*.mdx',
    { eager: true }
  );

  return Object.entries(caseStudyModules).map(([path, module]) => {
    const slug = path.split('/').pop().replace(/\.mdx$/, '');

    return {
      params: { slug },
      props: { caseStudy: module },
    };
  });
}

const { caseStudy } = Astro.props;
const Content = caseStudy.default;
const { title, subtitle, sections } = caseStudy.frontmatter;
---

<Layout title={`${title} | Portfolio`}>
  <main class="max-w-5xl mx-auto py-16 px-6 text-[var(--white)]">

    <a
      href="/#case-studies"
      class="text-[var(--sec)] hover:underline mb-8 inline-flex items-center gap-2 text-sm tracking-wide transition"
    >
      &larr; Back to case studies
    </a>

    <div>
      <h1 class="text-3xl md:text-5xl font-medium tracking-tight mb-8 leading-tight">
        {title}
      </h1>

      {subtitle && (
        <p class="text-lg md:text-xl text-[var(--white-icon)] mb-8 max-w-3xl">
          {subtitle}
        </p>
      )}

      <div class="project-description">
        <Content />
      </div>
    </div>

    <div class="space-y-4 mt-12">
      {sections?.map((section) => (
        <details class="details-card group rounded-xl bg-[#141414] overflow-hidden transition duration-300">
          <summary class="flex items-center justify-between px-6 py-5 md:px-8 md:py-6 cursor-pointer select-none font-medium text-white hover:text-[var(--sec)] transition-colors">
            <span class="text-lg md:text-xl font-semibold tracking-wide">{section.title}</span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5 text-[var(--white-icon)] group-open:rotate-180 transition-transform duration-300 flex-shrink-0 ml-4"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>

          <div class="px-6 pb-8 pt-4 md:px-8 md:pb-8 md:pt-4 text-[var(--white-icon)] border-t border-[#ffffff08] text-base leading-loose">
            <div set:html={section.content} />
          </div>
        </details>
      ))}
    </div>

  </main>
  <BackToTop />
</Layout>

<style is:global>
  .project-description {
    color: var(--white-icon);
    line-height: 1.8;
    max-width: 48rem;
  }

  .project-description p {
    margin-bottom: 1.25rem;
  }

  .project-description ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .project-description li {
    margin-bottom: 0.65rem;
    line-height: 1.75;
  }

  .project-description strong {
    color: var(--white);
  }

  details.details-card {
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  details.details-card:hover {
    border-color: rgba(97, 41, 226, 0.5) !important;
  }

  details.details-card[open] {
    border-color: #6129E2 !important;
    box-shadow: 0 0 20px -5px rgba(97, 41, 226, 0.3);
  }
  
  .details-card > div {
    line-height: 1.85 !important; /* Wyższy line-height dla całej treści */
  }

  .details-card ul {
    list-style-type: disc !important;
    padding-left: 1.5rem !important;
    margin: 1.25rem 0 1.5rem !important;
  }

  .details-card li {
    padding-left: 0.25rem;
    margin-bottom: 0.45rem !important; 
    line-height: 1.6 !important;
  }

  .details-card li::marker {
    color: var(--white-icon);
  }

  .details-card p {
    margin-bottom: 1.25rem !important; /* Większy odstęp pod akapitami */
  }

  /* Subtle button-style links */
  .details-card a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: #ffffff08;
    border: 1px solid #ffffff10;
    color: white;
    text-decoration: none;
    margin-top: 0.5rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .details-card a:hover {
    background: #ffffff15;
    border-color: #ffffff25;
    text-decoration: none;
  }

  .project-description em,
  .project-description i,
  .details-card em,
  .details-card i {
    font-style: italic;
  }

  .project-description h2 {
    color: #2dd4bf;
    font-size: 1.5rem; 
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin-top: 2.75rem; 
    margin-bottom: 1rem;
  }

 
  .project-description h2:first-of-type {
    margin-top: 2rem;
  }

  /* Spójny styl dla linków inline w tekście */
  .project-description a {
    color: #2dd4bf; 
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid rgba(45, 212, 191, 0.3);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .project-description a:hover {
    color: #5eead4; 
    border-color: #5eead4;
    background-color: rgba(45, 212, 191, 0.08);
    border-radius: 3px;
    padding: 0.1rem 0.2rem;
    margin: -0.1rem -0.2rem; 
  }
</style>