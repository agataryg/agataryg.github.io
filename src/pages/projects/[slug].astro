
---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projectModules = import.meta.glob(
    '../../../content/projects/*.mdx',
    { eager: true }
  );

  return Object.entries(projectModules).map(([path, module]) => {
    const slug = path.split('/').pop().replace(/\.mdx$/, '');

    return {
      params: { slug },
      props: { project: module },
    };
  });
}

const { project } = Astro.props;
const Content = project.default;
const { title, sections } = project.frontmatter;
---

<Layout title={`${title} | Portfolio`}>
  <main class="max-w-5xl mx-auto py-16 px-6 text-[var(--white)]">

    <a
      href="/#projects"
      class="text-[var(--sec)] hover:underline mb-8 inline-flex items-center gap-2 text-sm tracking-wide transition"
    >
      &larr; Back to projects
    </a>

    <div>
      <h1 class="text-3xl md:text-5xl font-medium tracking-tight mb-8 leading-tight">
        {title}
      </h1>

      <div class="project-description">
        <Content />
      </div>
    </div>

    <div class="space-y-4 mt-12">
      {sections?.map((section) => (
        <details class="details-card group rounded-xl bg-[#141414] overflow-hidden transition duration-300">
          <summary class="flex items-center justify-between p-5 cursor-pointer select-none font-medium text-white hover:text-[var(--sec)] transition-colors">
            <span class="text-lg">{section.title}</span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5 text-[var(--white-icon)] group-open:rotate-180 transition-transform duration-300"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>

          <div class="px-5 pb-6 pt-2 text-[var(--white-icon)] border-t border-[#ffffff08] leading-relaxed text-base">
            <div set:html={section.content} />
          </div>
        </details>
      ))}
    </div>

  </main>
</Layout>

<style is:global>
  .project-description {
    color: var(--white-icon);
    line-height: 1.75;
    max-width: 48rem;
  }

  .project-description p {
    margin-bottom: 1rem;
  }

  .project-description ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .project-description li {
    margin-bottom: 0.5rem;
  }

  .project-description strong {
    color: var(--white);
  }

  details.details-card {
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  details.details-card:hover {
    border-color: rgba(97, 41, 226, 0.5) !important;
  }

  details.details-card[open] {
    border-color: #6129E2 !important;
    box-shadow: 0 0 20px -5px rgba(97, 41, 226, 0.3);
  }
</style>
